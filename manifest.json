{
  "manifest_version": 3,
  "name": "Flor Mía WhatsApp Sender",
  "short_name": "Flor Mía WA",
  "description": "Extensión privada para ejecutar y verificar envíos preparados por Flor Mía.",
  "version": "0.9.6",
  "version_name": "0.9.6",
  "minimum_chrome_version": "120",
  "action": {
    "default_title": "Flor Mía WhatsApp Sender",
    "default_popup": "popup/index.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://appintegralflormia.netlify.app/*",
    "https://app-integral-fm.netlify.app/*",
    "http://localhost:5173/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content/whatsapp.js",
        "content/inbox-runtime.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://appintegralflormia.netlify.app/*",
        "https://app-integral-fm.netlify.app/*",
        "https://*.netlify.app/*",
        "http://localhost:5173/*"
      ],
      "include_globs": [
        "https://appintegralflormia.netlify.app/*",
        "https://app-integral-fm.netlify.app/*",
        "https://deploy-preview-*--appintegralflormia.netlify.app/*",
        "https://deploy-preview-*--app-integral-fm.netlify.app/*",
        "http://localhost:5173/*"
      ],
      "js": [
        "content/web-app-bridge.js",
        "content/inbox-web-app-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
